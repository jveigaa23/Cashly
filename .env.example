# Modelo de variáveis de ambiente do Cashly.
# Copie para .env.local e preencha. NUNCA versione valores reais.
# Variáveis NEXT_PUBLIC_* vão para o navegador: só coloque nelas valores públicos.

# --- Supabase (banco e autenticação) -----------------------------------------
# Painel do Supabase → Project Settings → API. Use a chave "publishable"
# (sb_publishable_...), protegida pelo RLS. NUNCA a service_role/secret aqui.
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Endereço público do app (usado nos links de e-mail e de convite).
# Local: http://localhost:3000 · Produção: https://<seu-dominio>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verificação de senha vazada (HaveIBeenPwned, k-anonimato: só os 5 primeiros
# caracteres do hash SHA-1 saem do servidor). Ligada por padrão; "off" desliga
# (usado na pilha local de testes, sem acesso à internet).
# PASSWORD_LEAK_CHECK=off

# --- Fase 6: notificações (somente servidor, exceto a chave pública VAPID) --
# SUPABASE_SECRET_KEY=<NUNCA no cliente; uso exclusivo do agendador>
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:responsavel@example.com
# CRON_SECRET=<segredo longo e aleatório para o endpoint do agendador>

# --- Fase 6 (opcional): WhatsApp Business Platform --------------------------
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_DUE_SOON=

# --- Testes E2E com login (SOMENTE ambiente de teste isolado) ---------------
# E2E_EMAIL= / E2E_PASSWORD=                 conta de teste com família
# E2E_INVITEE_EMAIL= / E2E_INVITEE_PASSWORD= segunda conta de teste, sem família
